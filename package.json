{
  "name": "@fastermessage/sdk",
  "version": "0.2.0",
  "description": "SDK Node.js officiel de l'API FasterMessage v2 : SMS, e-mail, OTP, contacts et webhooks.",
  "license": "MIT",
  "keywords": [
    "fastermessage",
    "sms",
    "email",
    "otp",
    "api",
    "sdk"
  ],
  "homepage": "https://www.fastermessage.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/urbantech229/fastermessage-node.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20.3"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/cjs-package.mjs",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test test/client.test.mjs test/cjs.test.cjs",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.9.0"
  }
}
